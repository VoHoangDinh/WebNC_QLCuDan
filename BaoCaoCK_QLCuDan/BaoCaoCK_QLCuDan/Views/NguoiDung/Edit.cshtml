@model BaoCaoCK_QLCuDan.Models.CuDan

@{
    ViewBag.Title = "Cập nhật thông tin cá nhân";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="mb-4">
    <h2 class="mb-2"><i class="fas fa-user-circle"></i> Thông tin cá nhân</h2>
    <p class="text-muted">Cập nhật thông tin cá nhân của bạn (Mã cư dân và Họ tên không thể thay đổi)</p>
</div>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}

@if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
{
    <div class="alert alert-success">
        @ViewBag.SuccessMessage
    </div>
}

@if (Model != null)
{
    <div class="card shadow-sm">
        @using (Html.BeginForm("Edit", "NguoiDung", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.MaCuDan)
            @Html.HiddenFor(model => model.HoTen)
            @Html.HiddenFor(model => model.MaHo)

            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="fas fa-user"></i> Thông tin cá nhân</h4>
                <div>
                    <a href="@Url.Action("Home", "NguoiDung")" class="btn btn-light text-primary font-weight-bold mr-2">
                        <i class="fas fa-times"></i> Hủy
                    </a>
                    <button type="submit" class="btn btn-light text-primary font-weight-bold">
                        <i class="fas fa-save"></i> Lưu thông tin
                    </button>
                </div>
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="font-weight-bold"><i class="fas fa-id-card"></i> Mã cư dân:</label>
                        <p class="form-control-plaintext bg-light p-2 rounded">@Model.MaCuDan</p>
                        <small class="text-muted">Mã cư dân không thể thay đổi</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="font-weight-bold"><i class="fas fa-user"></i> Họ và tên:</label>
                        <p class="form-control-plaintext bg-light p-2 rounded">@(Model.HoTen ?? "Chưa có thông tin")</p>
                        <small class="text-muted">Họ và tên không thể thay đổi</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <h5 class="text-primary border-bottom pb-2 mt-3">I. Thông tin cơ bản</h5>

                        <div class="form-group">
                            <label><i class="fas fa-birthday-cake"></i> Ngày sinh</label>
                            @Html.EditorFor(model => model.NgaySinh, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                            @Html.ValidationMessageFor(model => model.NgaySinh, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label><i class="fas fa-venus-mars"></i> Giới tính</label>
                            @Html.DropDownListFor(model => model.GioiTinh, new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Nam", Value = "Nam" },
                                new SelectListItem { Text = "Nữ", Value = "Nữ" }
                            }, "--- Chọn giới tính ---", new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.GioiTinh, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label><i class="fas fa-phone"></i> Số điện thoại</label>
                            @Html.EditorFor(model => model.SDT, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập số điện thoại" } })
                            @Html.ValidationMessageFor(model => model.SDT, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label><i class="fas fa-envelope"></i> Email</label>
                            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", type = "email", placeholder = "Nhập email" } })
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h5 class="text-primary border-bottom pb-2 mt-3">II. Trình độ & Chính trị</h5>

                        <div class="form-group">
                            <label><i class="fas fa-graduation-cap"></i> Trình độ học vấn</label>
                            @Html.EditorFor(model => model.TrinhDoHocVan, new { htmlAttributes = new { @class = "form-control", placeholder = "Ví dụ: Đại học, Thạc sĩ, Tiến sĩ..." } })
                            @Html.ValidationMessageFor(model => model.TrinhDoHocVan, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label><i class="fas fa-id-badge"></i> Học hàm/Học vị</label>
                            @Html.EditorFor(model => model.HocHamHocVi, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập học hàm/học vị" } })
                            @Html.ValidationMessageFor(model => model.HocHamHocVi, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label><i class="fas fa-calendar"></i> Ngày vào Đảng</label>
                            @Html.EditorFor(model => model.NgayVaoDang, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                            @Html.ValidationMessageFor(model => model.NgayVaoDang, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label><i class="fas fa-calendar-alt"></i> Ngày vào Đoàn</label>
                            @Html.EditorFor(model => model.NgayVaoDoan, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                            @Html.ValidationMessageFor(model => model.NgayVaoDoan, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12">
                        <h5 class="text-primary border-bottom pb-2">III. Đặc điểm nhận dạng</h5>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label><i class="fas fa-ruler-vertical"></i> Chiều cao</label>
                            @Html.EditorFor(model => model.NhanDang_Cao, new { htmlAttributes = new { @class = "form-control", placeholder = "Ví dụ: 170cm" } })
                            @Html.ValidationMessageFor(model => model.NhanDang_Cao, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label><i class="fas fa-face"></i> Sống mũi</label>
                            @Html.EditorFor(model => model.NhanDang_SongMui, new { htmlAttributes = new { @class = "form-control", placeholder = "Mô tả sống mũi" } })
                            @Html.ValidationMessageFor(model => model.NhanDang_SongMui, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label><i class="fas fa-info-circle"></i> Dấu vết đặc biệt</label>
                            @Html.EditorFor(model => model.DauVetDacBiet, new { htmlAttributes = new { @class = "form-control", placeholder = "Mô tả dấu vết đặc biệt" } })
                            @Html.ValidationMessageFor(model => model.DauVetDacBiet, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }
    
    .card-header {
        border-radius: 0 !important;
        background: #17a2b8 !important;
        border: none;
    }
    
    .form-group label {
        color: #343a40;
        font-weight: 600;
        margin-bottom: 5px;
    }
    
    .form-control {
        border-radius: 5px;
    }
    
    .form-control-plaintext {
        font-weight: 500;
        color: #495057;
    }
    
    .text-muted {
        font-size: 0.875rem;
    }
    
    .btn {
        border-radius: 5px;
        padding: 8px 20px;
    }
</style>

