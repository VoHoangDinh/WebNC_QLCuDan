@model BaoCaoCK_QLCuDan.Models.PhanAnh

@{
    ViewBag.Title = "Duyệt phản ánh";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .admin-card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        border: none;
        overflow: hidden;
        margin-top: 20px;
        margin-bottom: 20px;
    }

    .admin-card-header {
        background: linear-gradient(45deg, #4e73df, #224abe);
        color: white;
        padding: 20px 25px;
        border-bottom: 1px solid #e3e6f0;
    }

        .admin-card-header h2 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 600;
            display: flex;
            align-items: center;
        }

            .admin-card-header h2 i {
                margin-right: 10px;
            }

    .admin-card-body {
        padding: 30px;
    }

    /* Style cho các ô input chỉ đọc */
    .form-control[readonly] {
        background-color: #f8f9fc;
        border: 1px solid #eaecf4;
        color: #6e707e;
        font-weight: 500;
        cursor: not-allowed;
    }

    .control-label {
        font-weight: 600;
        color: #4e73df;
        margin-bottom: 8px;
        display: block; /* Đảm bảo label nằm trên input */
    }

    /* Vùng xử lý trạng thái */
    .status-section {
        background-color: #fff3cd;
        border: 1px solid #ffeeba;
        border-radius: 8px;
        padding: 20px;
        margin-top: 20px;
        transition: all 0.3s ease;
    }

        .status-section:hover {
            box-shadow: 0 4px 12px rgba(255, 193, 7, 0.2);
        }

    .btn-action-group {
        margin-top: 30px;
        display: flex;
        gap: 15px;
        border-top: 1px solid #eaecf4;
        padding-top: 20px;
    }

    .btn-save {
        background-color: #1cc88a;
        border-color: #1cc88a;
        color: white;
        padding: 10px 25px;
        font-weight: 600;
        box-shadow: 0 2px 6px rgba(28, 200, 138, 0.3);
    }

        .btn-save:hover {
            background-color: #17a673;
            transform: translateY(-1px);
        }

    .btn-back {
        background-color: #858796;
        border-color: #858796;
        color: white;
        padding: 10px 25px;
        font-weight: 600;
    }

        .btn-back:hover {
            background-color: #717384;
            text-decoration: none;
            color: white;
        }
</style>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="admin-card">
                    <div class="admin-card-header">
                        <h2>
                            <i class="fas fa-file-signature"></i>
                            Chi tiết & Duyệt Phản Ánh
                        </h2>
                    </div>

                    <div class="admin-card-body">
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                        @Html.HiddenFor(model => model.MaPhanAnh)
                        @Html.HiddenFor(model => model.MaCuDan)
                        @Html.HiddenFor(model => model.NgayGui)

                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="control-label">
                                    <i class="fas fa-user"></i> Mã cư dân / Người gửi
                                </label>
                                <input type="text" class="form-control"
                                       value="@(Model.CuDan != null ? Model.CuDan.HoTen : (Model.MaCuDan != null ? "Mã cư dân: " + Model.MaCuDan : "N/A"))"
                                       readonly />
                            </div>

                            <div class="col-md-6 form-group">
                                <label class="control-label">
                                    <i class="fas fa-calendar-alt"></i> Ngày gửi
                                </label>
                                <input type="text" class="form-control"
                                       value="@(Model.NgayGui.HasValue ? Model.NgayGui.Value.ToString("dd/MM/yyyy HH:mm") : "")"
                                       readonly />
                            </div>
                        </div>

                        <div class="form-group mt-3">
                            <label class="control-label">
                                <i class="fas fa-heading"></i> Tiêu đề phản ánh
                            </label>
                            @Html.EditorFor(model => model.TieuDe, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        </div>

                        <div class="form-group mt-3">
                            <label class="control-label">
                                <i class="fas fa-align-left"></i> Nội dung chi tiết
                            </label>
                            @Html.TextAreaFor(model => model.NoiDung, new { @class = "form-control", @rows = "6", @readonly = "readonly", @style = "resize: none;" })
                        </div>

                        <div class="status-section mt-4">
                            <div class="row align-items-center">
                                <div class="col-md-4">
                                    <label class="control-label text-dark mb-0" style="font-size: 1.1rem;">
                                        <i class="fas fa-tasks text-warning"></i> Trạng thái xử lý
                                    </label>
                                    <small class="text-muted d-block">Cập nhật tiến độ xử lý yêu cầu này.</small>
                                </div>
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.TrangThai,
                                        new SelectList((System.Collections.IEnumerable)ViewBag.TrangThaiList, Model.TrangThai),
                                        new { @class = "form-control form-select border-warning shadow-none", @style = "height: 45px; font-weight: bold;" })
                                </div>
                            </div>
                        </div>

                        <div class="btn-action-group">
                            <button type="submit" class="btn btn-save">
                                <i class="fas fa-save me-2"></i> Lưu & Cập nhật
                            </button>

                            <a href="@Url.Action("Index")" class="btn btn-back">
                                <i class="fas fa-arrow-left me-2"></i> Quay lại
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>