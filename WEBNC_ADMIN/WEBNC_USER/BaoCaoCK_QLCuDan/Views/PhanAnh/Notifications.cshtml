@model IEnumerable<BaoCaoCK_QLCuDan.Models.PhanAnh>
@{
    ViewBag.Title = "Thông báo";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="mb-4">
    <h2 class="mb-2"><i class="fas fa-bell"></i> Thông báo</h2>
    <p class="text-muted">Xem các thông báo về phản ánh đã được ban quản lý cập nhật trạng thái</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}


@if (Model != null && Model.Any())
{
    <div class="list-group">
        @foreach (var item in Model)
        {
            <a href="@Url.Action("Details", "PhanAnh", new { id = item.MaPhanAnh })" class="list-group-item list-group-item-action flex-column align-items-start mb-2 border rounded text-decoration-none">
                <div class="d-flex w-100 justify-content-between align-items-center">
                    <div class="flex-grow-1">
                        <h6 class="mb-1 text-dark">
                            <i class="fas fa-bullhorn text-info mr-2"></i>@item.TieuDe
                        </h6>
                        <small class="text-muted">
                            <i class="fas fa-clock mr-1"></i>@item.NgayGui.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    </div>
                    <div>
                        <span class="badge @(item.TrangThai == "Đang xử lý" ? "badge-warning" : item.TrangThai == "Đã xong" ? "badge-success" : "badge-info") badge-lg">
                            @item.TrangThai
                        </span>
                    </div>
                </div>
            </a>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> Hiện tại không có thông báo nào. Các phản ánh của bạn sẽ xuất hiện ở đây khi ban quản lý cập nhật trạng thái.
        <br />
        <a href="@Url.Action("Index", "PhanAnh")" class="alert-link mt-2 d-inline-block">Xem tất cả phản ánh</a>
    </div>
}

<style>
    .list-group-item {
        transition: all 0.3s ease;
        cursor: pointer;
    }
    .list-group-item:hover {
        background-color: #f8f9fa;
        transform: translateX(5px);
        text-decoration: none;
    }
    .list-group-item:hover .text-dark {
        color: #17a2b8 !important;
    }
    .badge-lg {
        font-size: 0.9rem;
        padding: 0.4rem 0.8rem;
    }
</style>

